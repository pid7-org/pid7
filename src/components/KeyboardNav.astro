---
---

<style is:global>
  [data-kb-section] {
    transition: all 200ms ease-out;
    scroll-margin-top: 2.5rem;
  }

  [data-kb-section][data-kb-active="true"] {
    position: relative;
  }

  [data-kb-section][data-kb-active="true"]::before {
    content: '';
    position: absolute;
    left: -12px;
    top: 0px;
    bottom: 0px;
    width: 2px;
    background-color: var(--color-accent);
    border-radius: 9999px;
  }

  @media (max-width: 640px) {
    [data-kb-section][data-kb-active="true"]::before {
      left: -6px;
    }
  }

  .kb-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    padding: 0 3px;
    font-size: 10px;
    font-family: inherit;
    border-radius: 3px;
    border: 1px solid var(--color-ctp-surface0);
    background-color: var(--color-ctp-surface0);
    color: var(--color-ctp-subtext0);
    line-height: 1;
    transition: all 120ms ease-out;
  }

  .kb-badge.active-key {
    background-color: var(--color-accent) !important;
    border-color: var(--color-accent) !important;
    color: var(--color-ctp-crust) !important;
    font-weight: 700;
    transform: scale(1.15);
  }

  .kb-badge-accent {
    border-color: color-mix(in srgb, var(--color-accent) 50%, var(--color-ctp-surface0)) !important;
    background-color: color-mix(in srgb, var(--color-accent) 12%, var(--color-ctp-surface0)) !important;
    color: var(--color-accent) !important;
    font-weight: 600;
  }

  [data-kb-item].kb-focused,
  [data-kb-item]:focus-visible {
    position: relative;
    background-color: color-mix(in srgb, var(--color-accent) 12%, transparent) !important;
    border-radius: 6px;
    outline: 2px solid var(--color-accent) !important;
    outline-offset: 2px;
    box-shadow: 0 0 12px color-mix(in srgb, var(--color-accent) 25%, transparent);
    transition: all 150ms ease-out;
  }

  [data-kb-item].kb-focused::before {
    content: '▶';
    position: absolute;
    left: -14px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 9px;
    color: var(--color-accent);
    line-height: 1;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    [data-kb-item].kb-focused::before {
      display: none;
    }
  }

  [data-kb-item].kb-focused a {
    color: var(--color-accent) !important;
  }

  .day-cell.kb-focused,
  .day-cell:focus,
  .day-cell:focus-visible {
    outline: 2px solid var(--color-accent) !important;
    outline-offset: 1.5px !important;
    transform: scale(1.65) !important;
    z-index: 35 !important;
    box-shadow: 0 0 10px var(--color-accent) !important;
  }
</style>

<script is:inline>
  (function () {
    let activeSectionIdx = -1;
    let currentFocusedElement = null;
    let pendingSeq = '';
    let pendingSeqTimer = null;

    function getSections() {
      return Array.from(document.querySelectorAll('[data-kb-section]')).sort((a, b) => {
        const numA = parseInt(a.getAttribute('data-kb-section') || '0', 10);
        const numB = parseInt(b.getAttribute('data-kb-section') || '0', 10);
        return numA - numB;
      });
    }

    function flashBadge(key) {
      const badges = document.querySelectorAll(`.kb-badge[data-kb="${key}"]`);
      badges.forEach((b) => {
        b.classList.add('active-key');
        setTimeout(() => b.classList.remove('active-key'), 180);
      });
    }

    function clearFocus() {
      if (currentFocusedElement) {
        currentFocusedElement.classList.remove('kb-focused');
        currentFocusedElement.removeAttribute('data-kb-focused');
        if (typeof currentFocusedElement.blur === 'function') {
          currentFocusedElement.blur();
        }
      }
      document.querySelectorAll('.kb-focused, [data-kb-focused]').forEach((el) => {
        el.classList.remove('kb-focused');
        el.removeAttribute('data-kb-focused');
      });
      currentFocusedElement = null;
    }

    function focusElement(el) {
      if (!el) return;
      clearFocus();
      currentFocusedElement = el;
      el.classList.add('kb-focused');
      el.setAttribute('data-kb-focused', 'true');
      if (typeof el.focus === 'function') {
        el.focus({ preventScroll: true });
      }
      el.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
    }

    function setActiveSection(idx) {
      const sections = getSections();
      if (sections.length === 0) return;

      if (idx < 0) idx = 0;
      if (idx >= sections.length) idx = sections.length - 1;

      sections.forEach((s) => s.removeAttribute('data-kb-active'));
      activeSectionIdx = idx;
      const target = sections[idx];
      target.setAttribute('data-kb-active', 'true');
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });

      if (target.id === 'section-activity') {
        const firstCell = target.querySelector('.day-cell[data-col="0"][data-row="0"]') || target.querySelector('.day-cell');
        if (firstCell) focusElement(firstCell);
      } else {
        const firstItem = target.querySelector('[data-kb-item]');
        if (firstItem) focusElement(firstItem);
        else clearFocus();
      }
    }

    function stepSection(delta) {
      const sections = getSections();
      if (sections.length === 0) return;
      let next = activeSectionIdx + delta;
      if (next < 0) next = sections.length - 1;
      if (next >= sections.length) next = 0;
      setActiveSection(next);
    }

    function getAllNonGridItems() {
      return Array.from(document.querySelectorAll('[data-kb-item]'));
    }

    function getPreGridItems() {
      const activitySec = document.getElementById('section-activity');
      const all = getAllNonGridItems();
      if (!activitySec) return all;
      return all.filter((el) => {
        return (activitySec.compareDocumentPosition(el) & Node.DOCUMENT_POSITION_PRECEDING) !== 0;
      });
    }

    function getPostGridItems() {
      const activitySec = document.getElementById('section-activity');
      const all = getAllNonGridItems();
      if (!activitySec) return [];
      return all.filter((el) => {
        return (activitySec.compareDocumentPosition(el) & Node.DOCUMENT_POSITION_FOLLOWING) !== 0;
      });
    }

    function getActivityCell(col, row) {
      return document.querySelector(`.day-cell[data-col="${col}"][data-row="${row}"]`);
    }

    function handleArrow(key) {
      if (currentFocusedElement && currentFocusedElement.classList.contains('day-cell')) {
        let col = parseInt(currentFocusedElement.dataset.col || '0', 10);
        let row = parseInt(currentFocusedElement.dataset.row || '0', 10);

        if (key === 'ArrowLeft') {
          if (col > 0) {
            const next = getActivityCell(col - 1, row);
            if (next) focusElement(next);
          } else {
            const pre = getPreGridItems();
            if (pre.length > 0) focusElement(pre[pre.length - 1]);
          }
          return;
        }

        if (key === 'ArrowRight') {
          if (col < 52) {
            const next = getActivityCell(col + 1, row);
            if (next) focusElement(next);
          } else {
            const post = getPostGridItems();
            if (post.length > 0) focusElement(post[0]);
          }
          return;
        }

        if (key === 'ArrowUp') {
          if (row > 0) {
            const next = getActivityCell(col, row - 1);
            if (next) focusElement(next);
          } else {
            const pre = getPreGridItems();
            if (pre.length > 0) focusElement(pre[pre.length - 1]);
          }
          return;
        }

        if (key === 'ArrowDown') {
          if (row < 6) {
            const next = getActivityCell(col, row + 1);
            if (next) focusElement(next);
          } else {
            const post = getPostGridItems();
            if (post.length > 0) focusElement(post[0]);
          }
          return;
        }
      }

      const allItems = getAllNonGridItems();
      if (allItems.length > 0) {
        let currentIdx = currentFocusedElement ? allItems.indexOf(currentFocusedElement) : -1;
        const preItems = getPreGridItems();
        const postItems = getPostGridItems();
        const hasGrid = !!document.getElementById('section-activity');

        if (key === 'ArrowDown' || key === 'ArrowRight') {
          if (currentIdx === -1) {
            focusElement(allItems[0]);
            return;
          }

          if (hasGrid && preItems.length > 0 && currentFocusedElement === preItems[preItems.length - 1]) {
            const firstCell = getActivityCell(0, 0) || document.querySelector('.day-cell');
            if (firstCell) {
              focusElement(firstCell);
              return;
            }
          }

          if (currentIdx < allItems.length - 1) {
            focusElement(allItems[currentIdx + 1]);
          }
          return;
        }

        if (key === 'ArrowUp' || key === 'ArrowLeft') {
          if (currentIdx === -1) {
            focusElement(allItems[allItems.length - 1]);
            return;
          }

          if (hasGrid && postItems.length > 0 && currentFocusedElement === postItems[0]) {
            const bottomCell = getActivityCell(0, 6) || document.querySelector('.day-cell');
            if (bottomCell) {
              focusElement(bottomCell);
              return;
            }
          }

          if (currentIdx > 0) {
            focusElement(allItems[currentIdx - 1]);
          }
          return;
        }
      }

      const articleLinks = Array.from(document.querySelectorAll('article a, [data-kb-section] a'));
      if (articleLinks.length > 0) {
        let idx = currentFocusedElement ? articleLinks.indexOf(currentFocusedElement) : -1;
        if (key === 'ArrowDown' || key === 'ArrowRight') {
          const next = idx < articleLinks.length - 1 ? idx + 1 : 0;
          focusElement(articleLinks[next]);
        } else {
          const prev = idx > 0 ? idx - 1 : articleLinks.length - 1;
          focusElement(articleLinks[prev]);
        }
      }
    }

    function triggerActive() {
      if (!currentFocusedElement) return;
      const link = currentFocusedElement.tagName === 'A'
        ? currentFocusedElement
        : currentFocusedElement.querySelector('a');
      if (link) {
        link.click();
        return;
      }
      currentFocusedElement.click();
    }

    document.addEventListener('focusin', (e) => {
      const target = e.target;
      if (target && (target.matches?.('[data-kb-item]') || target.matches?.('.day-cell'))) {
        if (currentFocusedElement && currentFocusedElement !== target) {
          currentFocusedElement.classList.remove('kb-focused');
          currentFocusedElement.removeAttribute('data-kb-focused');
        }
        currentFocusedElement = target;
        target.classList.add('kb-focused');
        target.setAttribute('data-kb-focused', 'true');
      }
    });

    window.addEventListener('keydown', (e) => {
      const activeEl = document.activeElement;
      const isInput =
        activeEl &&
        (activeEl.tagName === 'INPUT' ||
          activeEl.tagName === 'TEXTAREA' ||
          activeEl.tagName === 'SELECT' ||
          activeEl.isContentEditable);

      const cli = window.__cli;
      const isCliOpen = cli && cli.isOpen();

      if (e.key === 'Escape') {
        flashBadge('Escape');
        if (isCliOpen) {
          e.preventDefault();
          cli.close();
          return;
        }
        if (currentFocusedElement) {
          e.preventDefault();
          clearFocus();
          return;
        }
        const sections = getSections();
        sections.forEach((s) => s.removeAttribute('data-kb-active'));
        activeSectionIdx = -1;
        return;
      }

      if (isInput) {
        if (isCliOpen) {
          if ((e.shiftKey && (e.key === 'ArrowUp' || e.key === 'ArrowDown')) || e.key === 'PageUp' || e.key === 'PageDown') {
            e.preventDefault();
            const delta = e.key === 'ArrowUp' || e.key === 'PageUp' ? -140 : 140;
            cli.scrollBy(delta);
          }
        }
        return;
      }

      if (e.ctrlKey || e.metaKey || e.altKey) {
        return;
      }

      const key = e.key;

      if (key === 't' || key === 'T') {
        e.preventDefault();
        flashBadge('t');
        if (cli) cli.toggle();
        return;
      }

      if (isCliOpen) {
        return;
      }

      if (key === 'h' || key === 'H') {
        e.preventDefault();
        flashBadge('h');
        if (window.location.pathname !== '/') {
          window.location.href = '/';
        } else {
          window.scrollTo({ top: 0, behavior: 'smooth' });
          setActiveSection(0);
        }
        return;
      }

      if (pendingSeq === 'g') {
        clearTimeout(pendingSeqTimer);
        pendingSeq = '';
        if (key === 'g') {
          e.preventDefault();
          flashBadge('gg');
          window.scrollTo({ top: 0, behavior: 'smooth' });
          setActiveSection(0);
          return;
        }
      }

      if (key === 'g') {
        pendingSeq = 'g';
        flashBadge('gg');
        pendingSeqTimer = setTimeout(() => {
          pendingSeq = '';
        }, 500);
        return;
      }

      if (key === 'G') {
        e.preventDefault();
        flashBadge('G');
        window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
        const sections = getSections();
        if (sections.length > 0) setActiveSection(sections.length - 1);
        return;
      }

      if (key === 'j') {
        e.preventDefault();
        flashBadge('j');
        window.scrollBy({ top: 100, behavior: 'smooth' });
        return;
      }

      if (key === 'k') {
        e.preventDefault();
        flashBadge('k');
        window.scrollBy({ top: -100, behavior: 'smooth' });
        return;
      }

      if (key === '[') {
        e.preventDefault();
        flashBadge('[');
        stepSection(-1);
        return;
      }

      if (key === ']') {
        e.preventDefault();
        flashBadge(']');
        stepSection(1);
        return;
      }

      if (key === 'ArrowUp' || key === 'ArrowDown' || key === 'ArrowLeft' || key === 'ArrowRight') {
        e.preventDefault();
        flashBadge(key);
        handleArrow(key);
        return;
      }

      if (key === 'Enter') {
        if (currentFocusedElement) {
          e.preventDefault();
          triggerActive();
        }
      }
    });

    document.addEventListener('click', (e) => {
      const btn = e.target.closest?.('.kb-dock-btn');
      if (!btn) return;
      e.stopPropagation();
      const action = btn.getAttribute('data-kb-action');
      const cli = window.__cli;
      if (action === 'scroll') {
        window.scrollBy({ top: 100, behavior: 'smooth' });
      } else if (action === 'section') {
        stepSection(1);
      } else if (action === 'focus') {
        handleArrow('ArrowDown');
      } else if (action === 'jump') {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        setActiveSection(0);
      } else if (action === 'terminal') {
        if (cli) cli.toggle();
      } else if (action === 'close') {
        if (cli) cli.close();
      } else if (action === 'home') {
        if (window.location.pathname !== '/') window.location.href = '/';
        else {
          window.scrollTo({ top: 0, behavior: 'smooth' });
          setActiveSection(0);
        }
      }
    });

    if (window.location.hash) {
      setTimeout(() => {
        const hashEl = document.querySelector(window.location.hash);
        if (hashEl && hashEl.hasAttribute('data-kb-section')) {
          const sections = getSections();
          const idx = sections.indexOf(hashEl);
          if (idx >= 0) setActiveSection(idx);
        }
      }, 200);
    }
  })();
</script>
