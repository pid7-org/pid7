---
---

<style is:global>
  .kb-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    padding: 0 3px;
    font-size: 10px;
    font-family: inherit;
    border-radius: 3px;
    border: 1px solid var(--color-ctp-surface0);
    background-color: var(--color-ctp-surface0);
    color: var(--color-ctp-subtext0);
    line-height: 1;
    transition: all 120ms ease-out;
  }

  .kb-badge.active-key {
    background-color: var(--color-accent) !important;
    border-color: var(--color-accent) !important;
    color: var(--color-ctp-crust) !important;
    font-weight: 700;
    transform: scale(1.15);
  }

  .kb-badge-accent {
    border-color: color-mix(in srgb, var(--color-accent) 50%, var(--color-ctp-surface0)) !important;
    background-color: color-mix(in srgb, var(--color-accent) 12%, var(--color-ctp-surface0)) !important;
    color: var(--color-accent) !important;
    font-weight: 600;
  }
</style>

<script is:inline>
  (function () {
    let pendingSeq = '';
    let pendingSeqTimer = null;
    let targetScrollY = window.scrollY;
    let scrollAnimId = null;

    function smoothScrollBy(delta) {
      const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      if (Math.abs(targetScrollY - window.scrollY) > 120) {
        targetScrollY = window.scrollY;
      }
      targetScrollY = Math.max(0, Math.min(maxScroll, targetScrollY + delta));

      if (scrollAnimId !== null) {
        cancelAnimationFrame(scrollAnimId);
      }

      function animate() {
        const current = window.scrollY;
        const diff = targetScrollY - current;

        if (Math.abs(diff) <= 0.8) {
          window.scrollTo(0, targetScrollY);
          scrollAnimId = null;
          return;
        }

        window.scrollTo(0, current + diff * 0.2);
        scrollAnimId = requestAnimationFrame(animate);
      }

      scrollAnimId = requestAnimationFrame(animate);
    }

    window.addEventListener('wheel', () => {
      if (scrollAnimId !== null) {
        cancelAnimationFrame(scrollAnimId);
        scrollAnimId = null;
      }
      targetScrollY = window.scrollY;
    }, { passive: true });

    window.addEventListener('touchstart', () => {
      if (scrollAnimId !== null) {
        cancelAnimationFrame(scrollAnimId);
        scrollAnimId = null;
      }
      targetScrollY = window.scrollY;
    }, { passive: true });

    function flashBadge(key) {
      const badges = document.querySelectorAll(`.kb-badge[data-kb="${key}"]`);
      badges.forEach((b) => {
        b.classList.add('active-key');
        setTimeout(() => b.classList.remove('active-key'), 180);
      });
    }

    window.addEventListener('keydown', (e) => {
      const activeEl = document.activeElement;
      const isInput =
        activeEl &&
        (activeEl.tagName === 'INPUT' ||
          activeEl.tagName === 'TEXTAREA' ||
          activeEl.tagName === 'SELECT' ||
          activeEl.isContentEditable);

      const cli = window.__cli;
      const isCliOpen = cli && cli.isOpen();

      if (e.key === 'Escape') {
        flashBadge('Escape');
        if (isCliOpen) {
          e.preventDefault();
          cli.close();
        }
        return;
      }

      if (isInput) {
        if (isCliOpen) {
          if ((e.shiftKey && (e.key === 'ArrowUp' || e.key === 'ArrowDown')) || e.key === 'PageUp' || e.key === 'PageDown') {
            e.preventDefault();
            const delta = e.key === 'ArrowUp' || e.key === 'PageUp' ? -140 : 140;
            cli.scrollBy(delta);
          }
        }
        return;
      }

      if (e.ctrlKey || e.metaKey || e.altKey) {
        return;
      }

      const key = e.key;

      if (key === 't' || key === 'T') {
        e.preventDefault();
        flashBadge('t');
        if (cli) cli.toggle();
        return;
      }

      if (isCliOpen) {
        return;
      }

      if (key === 'h' || key === 'H') {
        e.preventDefault();
        flashBadge('h');
        if (window.location.pathname !== '/') {
          window.location.href = '/';
        } else {
          if (scrollAnimId !== null) cancelAnimationFrame(scrollAnimId);
          window.scrollTo({ top: 0, behavior: 'smooth' });
          targetScrollY = 0;
        }
        return;
      }

      if (pendingSeq === 'g') {
        clearTimeout(pendingSeqTimer);
        pendingSeq = '';
        if (key === 'g') {
          e.preventDefault();
          flashBadge('gg');
          if (scrollAnimId !== null) cancelAnimationFrame(scrollAnimId);
          window.scrollTo({ top: 0, behavior: 'smooth' });
          targetScrollY = 0;
          return;
        }
      }

      if (key === 'g') {
        pendingSeq = 'g';
        flashBadge('gg');
        pendingSeqTimer = setTimeout(() => {
          pendingSeq = '';
        }, 500);
        return;
      }

      if (key === 'G') {
        e.preventDefault();
        flashBadge('G');
        if (scrollAnimId !== null) cancelAnimationFrame(scrollAnimId);
        window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
        targetScrollY = document.documentElement.scrollHeight;
        return;
      }

      if (key === 'j') {
        e.preventDefault();
        flashBadge('j');
        smoothScrollBy(64);
        return;
      }

      if (key === 'k') {
        e.preventDefault();
        flashBadge('k');
        smoothScrollBy(-64);
        return;
      }
    });

    document.addEventListener('click', (e) => {
      const btn = e.target.closest?.('.kb-dock-btn');
      if (!btn) return;
      e.stopPropagation();
      const action = btn.getAttribute('data-kb-action');
      const cli = window.__cli;
      if (action === 'scroll') {
        smoothScrollBy(64);
      } else if (action === 'jump') {
        if (scrollAnimId !== null) cancelAnimationFrame(scrollAnimId);
        window.scrollTo({ top: 0, behavior: 'smooth' });
        targetScrollY = 0;
      } else if (action === 'terminal') {
        if (cli) cli.toggle();
      } else if (action === 'close') {
        if (cli) cli.close();
      } else if (action === 'home') {
        if (window.location.pathname !== '/') window.location.href = '/';
        else {
          if (scrollAnimId !== null) cancelAnimationFrame(scrollAnimId);
          window.scrollTo({ top: 0, behavior: 'smooth' });
          targetScrollY = 0;
        }
      }
    });
  })();
</script>
