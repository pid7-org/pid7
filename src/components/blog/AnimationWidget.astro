---
import { getAnimationWidget } from './animations';

interface Props {
  animId: string;
  description: string;
}

const { animId, description } = Astro.props;
const widget = getAnimationWidget(animId);
const renderedHtml = widget ? widget.render(description) : '';
---

<div class="blog-animation-wrapper my-8" data-anim-id={animId} data-anim-desc={description} set:html={renderedHtml} />

<script>
  import { getAnimationWidget } from './animations';

  function setupAnimation() {
    document.querySelectorAll('.blog-animation-wrapper').forEach((wrapper) => {
      const animId = wrapper.getAttribute('data-anim-id');
      if (!animId) return;

      const widget = getAnimationWidget(animId);
      if (!widget) return;

      const card = wrapper.querySelector('.blog-animation-card');
      if (card) {
        widget.init(wrapper);
      }
    });
  }

  setupAnimation();
  document.addEventListener('astro:after-swap', setupAnimation);
</script>
