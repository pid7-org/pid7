---
---

<div class="flex items-center gap-2">
  <!-- Accent Color Circle Button -->
  <button
    id="accent-toggle"
    type="button"
    class="w-4 h-4 rounded-full border border-ctp-text transition-transform duration-200 hover:scale-110 cursor-pointer focus:outline-none shrink-0"
    aria-label="Cycle Accent Color"
    title="Change accent color"
  ></button>

  <!-- Half-filled Circle Theme Toggle Button -->
  <button
    id="theme-toggle"
    type="button"
    class="w-4 h-4 rounded-full text-ctp-text transition-transform duration-500 ease-in-out hover:rotate-180 cursor-pointer focus:outline-none flex items-center justify-center shrink-0"
    aria-label="Toggle Theme"
    title="Toggle light/dark theme"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="w-4 h-4 block"
    >
      <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="2" fill="none" />
      <path d="M12 1v22a11 11 0 0 0 0-22z" fill="currentColor" stroke="none" />
    </svg>
  </button>
</div>

<script>
  const accents = ['mauve', 'blue', 'green', 'peach', 'mono'];

  function getStoredAccent(): string {
    const stored = localStorage.getItem('accent');
    return stored && accents.includes(stored) ? stored : 'mauve';
  }

  function applyAccent(accentName: string) {
    document.documentElement.setAttribute('data-accent', accentName);
    localStorage.setItem('accent', accentName);

    const isLatte = document.documentElement.classList.contains('latte');
    const hexMap: Record<string, Record<string, string>> = {
      dark: { mauve: '#cba6f7', blue: '#89b4fa', green: '#a6e3a1', peach: '#fab387', mono: '#cad3f5' },
      latte: { mauve: '#8839ef', blue: '#1e66f5', green: '#40a02b', peach: '#fe640b', mono: '#4c4f69' }
    };
    const currentHexMap = isLatte ? hexMap.latte : hexMap.dark;
    const hex = currentHexMap[accentName] || currentHexMap.mauve;

    const accentBtn = document.getElementById('accent-toggle');
    if (accentBtn) {
      accentBtn.style.backgroundColor = hex;
    }
  }

  function setupControls() {
    // Accent toggle
    const currentAccent = getStoredAccent();
    applyAccent(currentAccent);

    const accentBtn = document.getElementById('accent-toggle');
    accentBtn?.addEventListener('click', () => {
      const active = getStoredAccent();
      const nextIndex = (accents.indexOf(active) + 1) % accents.length;
      const nextAccent = accents[nextIndex];
      applyAccent(nextAccent);
    });

    // Theme toggle
    const themeBtn = document.getElementById('theme-toggle');
    themeBtn?.addEventListener('click', () => {
      const isLatte = document.documentElement.classList.contains('latte');
      if (isLatte) {
        document.documentElement.classList.remove('latte');
        document.documentElement.classList.add('dark', 'macchiato');
        localStorage.setItem('theme', 'dark');
      } else {
        document.documentElement.classList.remove('dark', 'macchiato');
        document.documentElement.classList.add('latte');
        localStorage.setItem('theme', 'latte');
      }
      applyAccent(getStoredAccent());
    });
  }

  setupControls();
  document.addEventListener('astro:after-swap', setupControls);
</script>
