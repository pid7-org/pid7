---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GithubActivityGraph from '../components/GithubActivityGraph.astro';
import { formatBlogDate, getAllBlogPosts } from '../lib/blog';

const posts = await getAllBlogPosts();

const team = [
	{
		name: 'Adii',
		image: '/adii.jpg',
		bio: 'Engineer by choice, exploring systems engineering and turning ideas into reality.',
		github: 'https://github.com/adityamotale',
	},
	{
		name: 'Sher',
		image: '/sher.jpg',
		bio: 'Chief Officer of Happiness, keeps morale high and sleeps through code reviews.',
	},
];
---

<Layout>
	<main class="w-full max-w-screen-md mx-auto px-4 sm:px-6 py-8 sm:py-14 space-y-8 sm:space-y-10">
		<Header />

		<section>
			<h2 class="mb-3 font-mono text-xs uppercase tracking-widest text-ctp-subtext0">
				Building
			</h2>
			<ul class="text-sm">
				<li class="group flex items-baseline justify-between gap-3 py-2 border-b border-ctp-surface0/40 last:border-0">
					<span>
						<a href="https://github.com/pid7-org/ashwa" target="_blank" rel="noreferrer" class="font-mono text-ctp-text font-medium transition-colors hover:text-[var(--color-accent)]">ashwa</a>
						<span class="text-ctp-subtext0"> — hardware accelerated routines for single substring search</span>
					</span>
					<a href="https://github.com/pid7-org/ashwa" target="_blank" rel="noreferrer" class="shrink-0 text-ctp-subtext0 group-hover:text-[var(--color-accent)] transition-colors" aria-label="ashwa github repository">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
							<line x1="7" y1="17" x2="17" y2="7"></line>
							<polyline points="7 7 17 7 17 17"></polyline>
						</svg>
					</a>
				</li>
				<li class="group flex items-baseline justify-between gap-3 py-2 border-b border-ctp-surface0/40 last:border-0">
					<span>
						<a href="https://github.com/pid7-org/turbofox" target="_blank" rel="noreferrer" class="font-mono text-ctp-text font-medium transition-colors hover:text-[var(--color-accent)]">turbofox</a>
						<span class="text-ctp-subtext0"> — persistent and efficient embedded KV database</span>
					</span>
					<a href="https://github.com/pid7-org/turbofox" target="_blank" rel="noreferrer" class="shrink-0 text-ctp-subtext0 group-hover:text-[var(--color-accent)] transition-colors" aria-label="turbofox github repository">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
							<line x1="7" y1="17" x2="17" y2="7"></line>
							<polyline points="7 7 17 7 17 17"></polyline>
						</svg>
					</a>
				</li>
				<li class="group flex items-baseline justify-between gap-3 py-2 border-b border-ctp-surface0/40 last:border-0">
					<span>
						<a href="https://github.com/pid7-org/rta" target="_blank" rel="noreferrer" class="font-mono text-ctp-text font-medium transition-colors hover:text-[var(--color-accent)]">rta</a>
						<span class="text-ctp-subtext0"> — minimal metadata store for durable system state</span>
					</span>
					<a href="https://github.com/pid7-org/rta" target="_blank" rel="noreferrer" class="shrink-0 text-ctp-subtext0 group-hover:text-[var(--color-accent)] transition-colors" aria-label="rta github repository">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
							<line x1="7" y1="17" x2="17" y2="7"></line>
							<polyline points="7 7 17 7 17 17"></polyline>
						</svg>
					</a>
				</li>
			</ul>
		</section>

		{posts.length > 0 && (
			<section>
				<h2 class="mb-3 font-mono text-xs uppercase tracking-widest text-ctp-subtext0">
					Writing
				</h2>
				<ul class="text-sm space-y-1">
					{posts.map((post) => (
						<li class="group flex items-baseline justify-between gap-4 py-2 border-b border-ctp-surface0/40 last:border-0">
							<a
								href={`/blog/${post.frontmatter.slug}`}
								class="font-serif text-base text-ctp-text font-medium transition-colors group-hover:text-[var(--color-accent)] leading-snug"
							>
								{post.frontmatter.title}
							</a>
							<span class="shrink-0 font-mono text-xs text-ctp-subtext0 select-none">
								{formatBlogDate(post.frontmatter.created)}
							</span>
						</li>
					))}
				</ul>
			</section>
		)}

		<GithubActivityGraph />

		<section>
			<h2 class="mb-4 font-mono text-xs uppercase tracking-widest text-ctp-subtext0">
				Team
			</h2>
			<div class="flex flex-col gap-6">
				{team.map((member) => (
					<div class="flex items-start gap-4 sm:gap-5">
						<img
							src={member.image}
							alt={member.name}
							class="w-10 h-10 sm:w-12 sm:h-12 object-cover shrink-0 border border-ctp-surface0/60"
						/>
						<div class="flex flex-col min-w-0 pt-0.5">
							<h3 class="font-mono text-sm font-medium text-ctp-text">
								{member.github ? (
									<a
										href={member.github}
										target="_blank"
										rel="noreferrer"
										class="transition-colors hover:text-[var(--color-accent)]"
									>
										{member.name}
									</a>
								) : (
									member.name
								)}
							</h3>
							<p class="text-xs text-ctp-subtext0 mt-1 leading-relaxed">
								{member.bio}
							</p>
						</div>
					</div>
				))}
			</div>
		</section>

		<div class="h-[40vh]"></div>

		<Footer />
	</main>
</Layout>
