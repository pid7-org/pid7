---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---

<Layout title="pid7">
	<main class="w-full max-w-screen-md mx-auto px-6 py-16 sm:py-24">
		<header class="flex items-start justify-between gap-6">
			<div class="flex flex-col">
				<h1 class="font-playwrite text-2xl sm:text-3xl font-semibold tracking-tight text-ctp-text">
					pid7
				</h1>
				<p class="mt-3 font-mono text-xs sm:text-sm text-ctp-subtext0 tracking-wide leading-relaxed">
					engineering ideas into reality
				</p>
			</div>
			<div class="flex flex-col items-end gap-3 shrink-0">
				<ThemeToggle />
				<span id="ist-clock" class="font-mono text-xs text-ctp-subtext0 select-none">
					--:--:-- IST
				</span>
			</div>
		</header>
	</main>
</Layout>

<script>
	function updateISTClock() {
		const clockEl = document.getElementById('ist-clock');
		if (!clockEl) return;
		const now = new Date();
		const formatter = new Intl.DateTimeFormat('en-GB', {
			timeZone: 'Asia/Kolkata',
			hour: '2-digit',
			minute: '2-digit',
			second: '2-digit',
			hour12: false
		});
		clockEl.textContent = `${formatter.format(now)} IST`;
	}

	updateISTClock();
	setInterval(updateISTClock, 1000);

	document.addEventListener('astro:after-swap', updateISTClock);
</script>
