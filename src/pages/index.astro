---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GithubActivityGraph from '../components/GithubActivityGraph.astro';
import { formatBlogDate, getAllBlogPosts } from '../lib/blog';
import { projects, team } from '../lib/projects';

const posts = await getAllBlogPosts();
---

<Layout>
	<main class="w-full max-w-screen-md mx-auto px-4 sm:px-6 py-8 sm:py-14 space-y-8 sm:space-y-10">
		<div id="section-intro" data-kb-section="1" data-kb-title="Intro" class="focus:outline-none">
			<Header />
		</div>

		<section id="section-building" data-kb-section="2" data-kb-title="Building" class="focus:outline-none">
			<h2 class="mb-3 font-mono text-xs uppercase tracking-widest text-ctp-subtext0">
				Building
			</h2>
			<ul class="text-sm space-y-2">
				{projects.map((project) => (
					<li data-kb-item class="group flex items-baseline justify-between gap-3 py-1 px-1.5 -mx-1.5 transition-colors">
						<span>
							<a href={project.url} target="_blank" rel="noreferrer" class="font-mono text-ctp-text font-medium transition-colors hover:text-[var(--color-accent)]">{project.name}</a>
							<span class="text-ctp-subtext0"> — {project.desc}</span>
						</span>
						<div class="flex items-center gap-2.5 shrink-0 text-xs font-mono select-none">
							{project.commits !== undefined && project.commits > 0 && (
								<span class="text-ctp-subtext0/60 text-[11px] italic">
									{project.commits} commits
								</span>
							)}
							<a href={project.url} target="_blank" rel="noreferrer" class="shrink-0 text-ctp-subtext0 group-hover:text-[var(--color-accent)] transition-colors" aria-label={`${project.name} github repository`}>
								<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
									<line x1="7" y1="17" x2="17" y2="7"></line>
									<polyline points="7 7 17 7 17 17"></polyline>
								</svg>
							</a>
						</div>
					</li>
				))}
			</ul>
		</section>

		{posts.length > 0 && (
			<section id="section-writing" data-kb-section="3" data-kb-title="Writing" class="focus:outline-none">
				<h2 class="mb-3 font-mono text-xs uppercase tracking-widest text-ctp-subtext0">
					Writing
				</h2>
				<ul class="text-sm space-y-1">
					{posts.map((post) => (
						<li data-kb-item class="group flex items-baseline justify-between gap-4 py-2 px-1.5 -mx-1.5 border-b border-ctp-surface0/40 last:border-0 transition-colors">
							<a
								href={`/blog/${post.frontmatter.slug}`}
								class="font-serif text-base text-ctp-text font-medium transition-colors group-hover:text-[var(--color-accent)] leading-snug"
							>
								{post.frontmatter.title}
							</a>
							<span class="shrink-0 font-mono text-xs text-ctp-subtext0 select-none">
								{formatBlogDate(post.frontmatter.created)}
							</span>
						</li>
					))}
				</ul>
			</section>
		)}

		<div id="section-activity" data-kb-section="4" data-kb-title="Activity" class="focus:outline-none">
			<GithubActivityGraph />
		</div>

		<section id="section-team" data-kb-section="5" data-kb-title="Team" class="focus:outline-none">
			<h2 class="mb-4 font-mono text-xs uppercase tracking-widest text-ctp-subtext0">
				Team
			</h2>
			<div class="flex flex-col gap-6">
				{team.map((member) => (
					<div data-kb-item class="flex items-start gap-4 sm:gap-5 p-1.5 -m-1.5 transition-colors">
						<img
							src={member.image}
							alt={member.name}
							class="w-10 h-10 sm:w-12 sm:h-12 object-cover shrink-0 border border-ctp-surface0/60"
						/>
						<div class="flex flex-col min-w-0 pt-0.5">
							<h3 class="font-mono text-sm font-medium text-ctp-text">
								{member.github ? (
									<a
										href={member.github}
										target="_blank"
										rel="noreferrer"
										class="transition-colors hover:text-[var(--color-accent)]"
									>
										{member.name}
									</a>
								) : (
									member.name
								)}
							</h3>
							<p class="text-xs text-ctp-subtext0 mt-1 leading-relaxed">
								{member.bio}
							</p>
						</div>
					</div>
				))}
			</div>
		</section>

		<div class="h-[40vh]"></div>

		<Footer />
	</main>
</Layout>
