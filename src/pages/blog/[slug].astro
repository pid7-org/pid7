---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import AnimationWidget from '../../components/blog/AnimationWidget.astro';
import { formatBlogDate, getAllBlogPosts, getBlogPostById } from '../../lib/blog';
import type { ParsedBlogPost } from '../../lib/parser/types';

export async function getStaticPaths() {
  const posts = await getAllBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.frontmatter.slug },
    props: { post },
  }));
}

interface Props {
  post: ParsedBlogPost;
}

const { post } = Astro.props;

const cleanContent = post.rawMarkdown
  .replace(/^---[\s\S]*?---/, '')
  .replace(/<[^>]*>/g, '')
  .replace(/\{@[^}]*\}/g, '')
  .replace(/\[\^[^\]]*\]/g, '')
  .replace(/#+\s+/g, '')
  .replace(/[\*\_`~]/g, '')
  .replace(/\s+/g, ' ')
  .trim();

const fallbackExcerpt = cleanContent.length > 160
  ? cleanContent.slice(0, 160).slice(0, Math.max(120, cleanContent.slice(0, 160).lastIndexOf(' '))) + '...'
  : cleanContent;

const pageDescription = post.frontmatter.description || fallbackExcerpt || 'engineering ideas into reality';
---

<Layout
  title={`${post.frontmatter.title} × pid7`}
  description={pageDescription}
  type="article"
  publishedTime={post.frontmatter.created}
  modifiedTime={post.frontmatter.lastUpdated}
  tags={post.frontmatter.tags}
>
	<main class="w-full max-w-screen-md mx-auto px-4 sm:px-6 py-8 sm:py-14 space-y-8 sm:space-y-10 min-w-0 overflow-hidden">
		<Header />

		<header class="space-y-2.5 sm:space-y-3">
			<h1 class="font-serif italic text-2xl sm:text-4xl font-semibold tracking-tight text-ctp-text leading-tight break-words">
				{post.frontmatter.title}
			</h1>

			<div class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono italic text-xs text-ctp-subtext0">
				<span>{formatBlogDate(post.frontmatter.created)}</span>
				<span class="text-ctp-surface1">•</span>
				<span>{post.readTimeMinutes} min read</span>
				<span class="text-ctp-surface1">•</span>
				<span>{post.wordCount} words</span>
			</div>
		</header>

		<article class="prose max-w-none font-mono leading-relaxed text-ctp-text space-y-5 sm:space-y-6 min-w-0">
			<div set:html={post.html} />
		</article>

		<footer class="mt-6 sm:mt-8 flex flex-wrap items-center justify-between gap-3 sm:gap-4 font-mono italic text-xs text-ctp-subtext0 border-t border-ctp-surface0/40 pt-4">
			<div class="flex flex-wrap items-center gap-2">
				{post.frontmatter.tags.map((tag) => (
					<span class="text-ctp-subtext1">
						#{tag}
					</span>
				))}
			</div>
			{post.frontmatter.lastUpdated && post.frontmatter.lastUpdated !== post.frontmatter.created && (
				<span class="text-ctp-subtext0 text-xs select-none">
					last updated on {formatBlogDate(post.frontmatter.lastUpdated)}
				</span>
			)}
		</footer>

		{post.glossary.length > 0 && (
			<section class="mt-8 sm:mt-12 space-y-4 sm:space-y-6">
				<h2 id="glossary" class="font-serif italic text-lg sm:text-xl font-semibold text-[var(--color-accent)]">
					#glossary
				</h2>

				<div class="space-y-3.5 sm:space-y-4">
					{post.glossary.map((item) => (
						<div class="space-y-1 min-w-0">
							<div class="font-mono text-xs sm:text-sm font-semibold text-[var(--color-accent)]">
								{item.term}
							</div>
							<div class="font-mono text-xs sm:text-sm text-ctp-text leading-relaxed break-words" set:html={item.definitionHtml} />
						</div>
					))}
				</div>
			</section>
		)}

		{post.references.length > 0 && (
			<section class="mt-8 sm:mt-12 space-y-4 sm:space-y-6">
				<h2 id="references" class="font-serif italic text-lg sm:text-xl font-semibold text-[var(--color-accent)]">
					#references
				</h2>

				<ol class="space-y-3.5 sm:space-y-4">
					{post.references.map((ref) => (
						<li id={`fn-${ref.id}`} class="flex items-start gap-2.5 sm:gap-3 font-mono text-xs sm:text-sm">
							<span class="font-mono text-xs font-bold text-[var(--color-accent)] shrink-0 mt-0.5">
								[{ref.label}]
							</span>
							<div class="space-y-2 flex-1 min-w-0">
								<div class="leading-relaxed text-ctp-text break-words" set:html={ref.contentHtml} />
							</div>
							<a
								href={`#fnref-${ref.id}`}
								class="font-mono text-xs text-ctp-subtext0 hover:text-[var(--color-accent)] transition-colors shrink-0 select-none"
								title="Back to text"
							>
								↩
							</a>
						</li>
					))}
				</ol>
			</section>
		)}
	</main>
</Layout>

<script>
  import { getAnimationWidget } from '../../components/blog/animations';

  function renderAnimationWidgets() {
    const wrappers = document.querySelectorAll('.blog-animation-wrapper');
    wrappers.forEach((wrapper) => {
      const animId = wrapper.getAttribute('data-anim-id');
      const desc = wrapper.getAttribute('data-anim-desc') || '';
      if (!animId) return;

      const widget = getAnimationWidget(animId);
      if (!widget) return;

      const slot = wrapper.querySelector('.anim-slot');
      if (slot) {
        slot.outerHTML = widget.render(desc);
        widget.init(wrapper);
      }
    });
  }

  function setupCopyButtons() {
    document.querySelectorAll('.copy-code-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const encodedCode = btn.getAttribute('data-code');
        let textToCopy = '';
        if (encodedCode) {
          textToCopy = decodeURIComponent(encodedCode);
        } else {
          const card = btn.closest('.custom-code-block');
          const codeEl = card?.querySelector('.code-body pre code');
          textToCopy = codeEl?.textContent || '';
        }

        try {
          await navigator.clipboard.writeText(textToCopy);
        } catch (err) {
          console.error('Failed to copy code to clipboard', err);
        }
      });
    });
  }

  renderAnimationWidgets();
  setupCopyButtons();

  document.addEventListener('astro:after-swap', () => {
    renderAnimationWidgets();
    setupCopyButtons();
  });
</script>
