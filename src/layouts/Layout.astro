---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Astro Catppuccin Theme' } = Astro.props;
---
<!doctype html>
<html lang="en" class="dark macchiato">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return 'dark';
			})();
			if (theme === 'latte' || theme === 'light') {
				document.documentElement.classList.remove('dark', 'macchiato');
				document.documentElement.classList.add('latte');
			} else {
				document.documentElement.classList.remove('latte');
				document.documentElement.classList.add('dark', 'macchiato');
			}
			window.localStorage.setItem('theme', theme);
		</script>
	</head>
	<body class="bg-ctp-base text-ctp-text min-h-screen transition-colors duration-200 antialiased">
		<slot />
	</body>
</html>
