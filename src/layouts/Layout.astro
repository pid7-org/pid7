---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  author?: string;
}

const {
  title = 'pid7 × engineering ideas into reality',
  description = 'engineering ideas into reality',
  image = '/web-app-manifest-512x512.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  author = 'pid7',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const socialImageURL = new URL(image, Astro.site || Astro.url.origin);

const jsonLd = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': title,
  'description': description,
  'url': canonicalURL.toString(),
  'datePublished': publishedTime,
  'dateModified': modifiedTime || publishedTime,
  'author': {
    '@type': 'Person',
    'name': author,
    'url': (Astro.site || Astro.url.origin).toString()
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'pid7',
    'logo': {
      '@type': 'ImageObject',
      'url': new URL('/web-app-manifest-512x512.png', Astro.site || Astro.url.origin).toString()
    }
  },
  ...(tags.length > 0 ? { 'keywords': tags.join(', ') } : {}),
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': canonicalURL.toString()
  }
} : {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'pid7',
  'url': canonicalURL.toString(),
  'description': description
};
---
<!doctype html>
<html lang="en" class="dark macchiato" data-accent="mauve">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="author" content={author} />
		{tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="sitemap" href="/sitemap.xml" />
		<link rel="alternate" type="application/rss+xml" title="pid7 × engineering ideas into reality" href="/rss.xml" />

		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="pid7" />
		<meta name="application-name" content="pid7" />
		<meta name="theme-color" content="#24273a" />
		<link rel="manifest" href="/site.webmanifest" />

		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="pid7" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:width" content="512" />
		<meta property="og:image:height" content="512" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:alt" content={title} />
		<meta property="og:locale" content="en_US" />
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
		{tags.map((tag) => <meta property="article:tag" content={tag} />)}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />
		<meta name="twitter:image:alt" content={title} />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<meta name="generator" content={Astro.generator} />
		<script is:inline>
			(function() {
				const theme = (() => {
					if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
						return localStorage.getItem('theme');
					}
					return 'dark';
				})();
				if (theme === 'latte' || theme === 'light') {
					document.documentElement.classList.remove('dark', 'macchiato');
					document.documentElement.classList.add('latte');
				} else {
					document.documentElement.classList.remove('latte');
					document.documentElement.classList.add('dark', 'macchiato');
				}

				const accent = (typeof localStorage !== 'undefined' && localStorage.getItem('accent')) || 'mauve';
				document.documentElement.setAttribute('data-accent', accent);
			})();
		</script>
	</head>
	<body class="text-ctp-text min-h-screen transition-colors duration-200 antialiased">
		<slot />
	</body>
</html>

